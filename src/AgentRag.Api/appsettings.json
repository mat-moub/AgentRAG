{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=AgentRag;Username=postgres"
  },
  "OpenAI": {
    "Endpoint": "https://openai-moubri-ai-test.services.ai.azure.com/openai/v1",
    "ApiKey": "",
    "ChatModel": "gpt-6-luna",
    "EmbeddingModel": "text-embedding-3-small",
    "NetworkTimeoutSeconds": 1800
  },
  "Ingestion": { "BatchSize": 16, "MaxRetries": 3, "SaveCommandTimeoutSeconds": 600 },
  "OAuth": {
    "Issuer": "http://127.0.0.1:5000/",
    "SiteUrl": "http://127.0.0.1:5173/",
    "KnownProxies": []
  },
  "Cors": { "Origins": [ "http://localhost:5173", "http://127.0.0.1:5173" ] },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": { "IncludeScopes": true, "SingleLine": true, "TimestampFormat": "HH:mm:ss " }
    }
  },
  "AllowedHosts": "*"
}
