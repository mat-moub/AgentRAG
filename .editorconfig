# Coding standards for AgentRAG. Build-time analyzers (StyleCop, .NET analyzers, IDE code style) read
# their severities from this file; Directory.Build.props enables them for every .NET project.
# Rules are calibrated to the conventions of this repository: compact, intention-revealing code where
# a reader sees the whole idea at once. A rule set to "none" below conflicts with those conventions,
# not with readability; the reason is given next to it.
root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,mjs,json,css,html,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{csproj,props,targets,slnx,xml,config}]
indent_size = 2

[*.cs]
indent_size = 4

#### C# code style (IDE rules, enforced at build time) ####

csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion

# Dead code and noise: keep the code base free of what nobody reads.
dotnet_diagnostic.IDE0005.severity = warning  # unnecessary using directive
dotnet_diagnostic.IDE0035.severity = warning  # unreachable code
dotnet_diagnostic.IDE0044.severity = warning  # field can be readonly
dotnet_diagnostic.IDE0051.severity = warning  # unused private member
dotnet_diagnostic.IDE0052.severity = warning  # unread private member
dotnet_diagnostic.IDE0059.severity = warning  # value assigned but never used
dotnet_diagnostic.IDE0161.severity = warning  # file-scoped namespace
dotnet_diagnostic.IDE0003.severity = warning  # no this. qualification
dotnet_diagnostic.IDE0049.severity = warning  # use language keywords for types

#### Naming ####

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i
dotnet_naming_rule.interfaces_start_with_i.severity = warning

dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, enum, delegate, property, method, event
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.types_and_members_are_pascal.symbols = types_and_members
dotnet_naming_rule.types_and_members_are_pascal.style = pascal
dotnet_naming_rule.types_and_members_are_pascal.severity = warning

dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.constants_are_pascal.symbols = constants
dotnet_naming_rule.constants_are_pascal.style = pascal
dotnet_naming_rule.constants_are_pascal.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel.capitalization = camel_case
dotnet_naming_rule.private_fields_are_camel.symbols = private_fields
dotnet_naming_rule.private_fields_are_camel.style = camel
dotnet_naming_rule.private_fields_are_camel.severity = warning

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter, local
dotnet_naming_rule.locals_and_parameters_are_camel.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters_are_camel.style = camel
dotnet_naming_rule.locals_and_parameters_are_camel.severity = warning

#### StyleCop: rules kept as warnings unless listed here ####

# Readability rules that conflict with the repository conventions.
dotnet_diagnostic.SA1101.severity = none  # this. prefix: members are unambiguous with primary constructors
dotnet_diagnostic.SA1309.severity = none  # field names may not start with underscore (none do; kept quiet)
dotnet_diagnostic.SA1503.severity = none  # braces on single-line if/for: one-line guards stay one line (SA1519/SA1520 still apply)
dotnet_diagnostic.SA1501.severity = none  # statement on a single line: short blocks such as finally { gate.Release(); }
dotnet_diagnostic.SA1502.severity = none  # element on a single line: one-line records and members
dotnet_diagnostic.SA1500.severity = none  # brace placement in object and collection initializers
dotnet_diagnostic.SA1107.severity = none  # several statements in short lambdas: c => { c.Status = 401; return ...; }
dotnet_diagnostic.SA1116.severity = none  # wrapped parameter lists continue on the declaration line
dotnet_diagnostic.SA1117.severity = none  # parameters wrap by width rather than one per line
dotnet_diagnostic.SA1118.severity = none  # raw string and lambda arguments span several lines
dotnet_diagnostic.SA1122.severity = none  # "" is as clear as string.Empty
dotnet_diagnostic.SA1133.severity = none  # [ApiController, Authorize, Route(...)] on one line
dotnet_diagnostic.SA1413.severity = none  # trailing commas in initializers
dotnet_diagnostic.SA1512.severity = none  # comment followed by blank line
dotnet_diagnostic.SA1513.severity = none  # blank line after closing brace
dotnet_diagnostic.SA1514.severity = none  # blank line before documentation header
dotnet_diagnostic.SA1515.severity = none  # blank line before single-line comment
dotnet_diagnostic.SA1516.severity = none  # blank line between elements: related records sit together
dotnet_diagnostic.SA1201.severity = none  # member ordering: code is ordered by feature, top-down
dotnet_diagnostic.SA1202.severity = none  # member ordering by accessibility
dotnet_diagnostic.SA1203.severity = none  # constants first
dotnet_diagnostic.SA1204.severity = none  # static members first
dotnet_diagnostic.SA1402.severity = none  # one type per file: request/response records live with their controller or service
dotnet_diagnostic.SA1649.severity = none  # file name matches first type (same reason)
dotnet_diagnostic.SA1633.severity = none  # file header: the license is at the repository root

# Documentation is written where it explains intent, not for every member.
dotnet_diagnostic.CS1591.severity = none  # missing XML comment
dotnet_diagnostic.CS1573.severity = none  # parameter without <param> when others have one
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none
dotnet_diagnostic.SA1611.severity = none
dotnet_diagnostic.SA1612.severity = none
dotnet_diagnostic.SA1615.severity = none
dotnet_diagnostic.SA1623.severity = none  # property summary must start with "Gets"
dotnet_diagnostic.SA1629.severity = none  # documentation text must end with a period

#### .NET analyzers (AnalysisMode = Recommended) ####

dotnet_diagnostic.CA1848.severity = none        # LoggerMessage delegates: logging is not on a hot path here
dotnet_diagnostic.CA1873.severity = none        # cheap logging arguments (counts, durations)
dotnet_diagnostic.CA1711.severity = none        # type names ending in Queue (WikiRunQueue is not a collection)
dotnet_diagnostic.CA1068.severity = suggestion  # CancellationToken last: MCP tool and service signatures keep optional filters after it
dotnet_diagnostic.CA1304.severity = suggestion  # ToLower() inside EF Core queries is translated to SQL lower()
dotnet_diagnostic.CA1311.severity = suggestion  # same reason
dotnet_diagnostic.CA1862.severity = suggestion  # StringComparison overloads are not translated by EF Core
dotnet_diagnostic.CA1716.severity = suggestion
dotnet_diagnostic.CA1859.severity = suggestion
dotnet_diagnostic.CA1861.severity = suggestion

# Generated EF Core migrations are not hand-written code.
[src/AgentRag.Api/Data/Migrations/**.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# Tests: names read as sentences (Method_Condition_Expectation) and fixtures may use test-only shortcuts.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none  # underscores in test names
dotnet_diagnostic.CA1050.severity = none  # test classes without namespace
dotnet_diagnostic.CA5350.severity = none  # SHA-1 computes Git blob ids in fakes
dotnet_diagnostic.CA1822.severity = none  # test hosts expose helpers as instance members (host.AuthorizeUrl(...))
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA2007.severity = none
